  "shadowing": {
    "sh-01": {
      "meaning": "처음 뵙겠습니다. 잘 부탁드립니다.",
      "focus": "자기소개에 쓰는 정중한 억양",
      "tip": "\"はじめまして\"와 \"おねがいします\"의 부드럽게 내려가는 억양에 주의하세요."
    },
    "sh-02": {
      "meaning": "이것은 제 가방이에요.",
      "focus": "조사 \"は(wa)\"와 \"の\" 주변의 자연스러운 리듬과 쉼",
      "tip": "명사와 조사 \"は(wa)\" / \"の\" 사이를 매끄럽게 잇고 살짝 쉬어 주세요."
    },
    "sh-03": {
      "meaning": "매일 아침 7시에 일어나요.",
      "focus": "시간 조사 \"に\"와 동사 \"おきます\"의 리듬",
      "tip": "시간 조사 \"に\"에서 \"おきます\"로 경쾌하게 이어지는 리듬을 살리세요."
    },
    "sh-04": {
      "meaning": "같이 커피 마시지 않을래요?",
      "focus": "촉음 \"っ\"의 쉼과 권유 표현 \"〜ませんか\"의 올라가는 억양",
      "tip": "촉음 \"っ\"에서 한 박 쉬고, \"〜ませんか\" 끝을 자연스럽게 올리세요."
    },
    "sh-05": {
      "meaning": "어제 도서관에서 책을 읽었어요.",
      "focus": "장소 조사 \"で\"와 과거형 \"〜ました\"의 발음",
      "tip": "장소 조사 \"で\"와 과거형 \"〜ました\"를 매끄럽게 이어 말하세요."
    },
    "sh-06": {
      "meaning": "실례합니다, 역은 어디예요?",
      "focus": "정중하게 묻는 말투와 의문문 끝 억양",
      "tip": "\"どこですか\"에서 자연스럽게 묻는 억양을 살리세요."
    },
    "sh-07": {
      "meaning": "이 사과는 아주 맛있어요.",
      "focus": "부사 \"とても\"의 강조와 형용사 어미",
      "tip": "\"とても\"를 힘 있게 강조하고 \"おいしいです\"의 높낮이를 살리세요."
    },
    "sh-08": {
      "meaning": "버스로 학교에 가요.",
      "focus": "수단 조사 \"で\"와 방향 조사 \"へ(e)\"",
      "tip": "목적지를 나타내는 조사 \"へ\"는 \"e\"로 발음해요."
    },
    "sh-09": {
      "meaning": "내일 친구와 영화를 봐요.",
      "focus": "동반 조사 \"と\"와 목적격 조사 \"を\"의 매끄러운 연결",
      "tip": "동반 조사 \"と\"와 목적격 조사 \"を\" 사이의 리듬을 고르게 유지하세요."
    },
    "sh-10": {
      "meaning": "오늘은 날씨가 정말 좋네요.",
      "focus": "문장 끝에서 공감을 구하는 종조사 \"ね\"",
      "tip": "공감을 구하는 종조사 \"ね\"를 편안하고 다정한 말투로 말하세요."
    },
    "sh-11": {
      "meaning": "책상 위에 책이 있어요.",
      "focus": "또렷한 \"つ\" 발음과 존재 동사 \"あります\"",
      "tip": "\"つ\"는 입술을 너무 둥글게 오므리지 말고 또렷하게 발음하세요."
    },
    "sh-12": {
      "meaning": "여름 방학에 바다에 가고 싶어요.",
      "focus": "\"つ\"와 \"す\"의 구별과 희망 표현 \"〜たいです\"",
      "tip": "\"なつ\"의 \"つ(tsu)\"와 \"やすみ\"의 \"す(su)\"를 구별해서 연습하세요."
    },
    "sh-13": {
      "meaning": "겨울은 아주 추워요.",
      "focus": "\"ふ\"의 양순 무성 마찰음 (영어 f가 아님)",
      "tip": "윗니를 아랫입술에 대지 말고 두 입술 사이로 살짝 바람을 부세요."
    },
    "sh-14": {
      "meaning": "새 신발을 샀어요.",
      "focus": "\"ら\"의 탄음과 \"つ\"의 조합",
      "tip": "\"ら\"는 혀끝으로 입천장을 가볍게 한 번 튕기세요 (영어 r이나 l이 아니에요)."
    },
    "sh-15": {
      "meaning": "이 요리는 맵지 않아요.",
      "focus": "\"ら\", \"り\"와 요음 \"りょ\"의 리듬",
      "tip": "\"りょうり\"와 \"からくない\"에서 계속 혀를 가볍게 튕기며 말하세요."
    },
    "sh-16": {
      "meaning": "밤늦게까지 일했어요.",
      "focus": "문장 속 \"る\"와 \"ら\"의 가벼운 탄음",
      "tip": "\"よる\"의 \"る\"와 \"はたらき\"의 \"ら\"는 빠르고 가볍게 튕기세요."
    },
    "sh-17": {
      "meaning": "비행기로 일본에 가요.",
      "focus": "무성 경구개 마찰음 \"ひ\"와 수단 조사 \"で\"",
      "tip": "\"ひ\"는 공기를 단단한 입천장 쪽으로 보내고 \"し\"처럼 뭉개지 마세요."
    },
    "sh-18": {
      "meaning": "작은 고양이가 책상 밑에 있어요.",
      "focus": "\"ち\"와 \"つ\"의 구별과 존재 동사 \"います\"",
      "tip": "\"ちいさい\"의 \"ち(chi)\"와 \"つくえ\"의 \"つ(tsu)\"를 또렷하게 구별해서 연습하세요."
    }
  }
}
