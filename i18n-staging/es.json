  "shadowing": {
    "sh-01": {
      "meaning": "Encantado de conocerte. Es un placer.",
      "focus": "Entonación cortés para presentarse",
      "tip": "Fíjate en la suave entonación descendente de \"hajimemashite\" y \"onegaishimasu\"."
    },
    "sh-02": {
      "meaning": "Este es mi bolso.",
      "focus": "Ritmo natural y pausas alrededor de las partículas \"wa\" y \"no\"",
      "tip": "Fluidez y pausas breves entre los sustantivos y las partículas \"wa\" / \"no\"."
    },
    "sh-03": {
      "meaning": "Me levanto a las 7:00 todas las mañanas.",
      "focus": "Ritmo de la partícula de tiempo \"ni\" y el verbo \"okimasu\"",
      "tip": "Ritmo ágil en la partícula de tiempo \"ni\" al pasar a \"okimasu\"."
    },
    "sh-04": {
      "meaning": "¿Quieres tomar un café conmigo?",
      "focus": "Pausa de la consonante doble y tono ascendente en la invitación \"~masen ka\"",
      "tip": "Haz una pausa breve en la consonante doble \"っ\" y sube la entonación de forma natural al final de \"~masen ka\"."
    },
    "sh-05": {
      "meaning": "Ayer leí un libro en la biblioteca.",
      "focus": "Partícula de lugar \"de\" y terminación de pasado \"~mashita\"",
      "tip": "Transición fluida entre la partícula de lugar \"de\" y el pasado \"~mashita\"."
    },
    "sh-06": {
      "meaning": "Disculpe, ¿dónde está la estación?",
      "focus": "Tono cortés de pregunta y final interrogativo ascendente",
      "tip": "Entonación interrogativa natural y ascendente en \"doko desu ka\"."
    },
    "sh-07": {
      "meaning": "Esta manzana está muy rica.",
      "focus": "Énfasis en el adverbio \"totemo\" con la terminación del adjetivo",
      "tip": "Enfatiza \"totemo\" con expresividad y sigue la cadencia de \"oishii desu\"."
    },
    "sh-08": {
      "meaning": "Voy a la escuela en autobús.",
      "focus": "Partícula de medio \"de\" y partícula de dirección \"e\" (escrita へ)",
      "tip": "Pronuncia la partícula \"へ\" como \"e\" cuando indica destino."
    },
    "sh-09": {
      "meaning": "Mañana voy a ver una película con un amigo.",
      "focus": "Ritmo fluido entre la partícula de compañía \"to\" y la partícula de objeto \"o\"",
      "tip": "Cadencia equilibrada entre la partícula de compañía \"to\" y el objeto directo \"o\"."
    },
    "sh-10": {
      "meaning": "Hoy hace muy buen tiempo, ¿verdad?",
      "focus": "Partícula final \"ne\" para buscar complicidad",
      "tip": "Tono relajado y amable en la partícula final \"ne\", que busca el acuerdo del otro."
    },
    "sh-11": {
      "meaning": "Hay un libro sobre el escritorio.",
      "focus": "Pronunciación nítida de \"tsu\" y el verbo de existencia \"arimasu\"",
      "tip": "Pronuncia \"tsu\" con nitidez y sin redondear demasiado los labios."
    },
    "sh-12": {
      "meaning": "Quiero ir a la playa en las vacaciones de verano.",
      "focus": "Distinguir \"tsu\" de \"su\" y la forma de deseo \"~tai desu\"",
      "tip": "Practica la diferencia entre \"tsu\" en \"natsu\" y \"su\" en \"yasumi\"."
    },
    "sh-13": {
      "meaning": "En invierno hace mucho frío.",
      "focus": "Fricativa bilabial sorda de \"fu\" (no es la \"f\" del español)",
      "tip": "Sopla suavemente entre los labios sin apoyar los dientes de arriba en el labio inferior."
    },
    "sh-14": {
      "meaning": "Compré zapatos nuevos.",
      "focus": "Combinación de la vibración de \"ra\" y \"tsu\"",
      "tip": "Toca ligeramente el paladar con la lengua para \"ra\", como la r de \"pero\" (no es una r fuerte ni una l)."
    },
    "sh-15": {
      "meaning": "Este plato no pica.",
      "focus": "Ritmo de \"ra\", \"ri\" y el yōon \"ryo\"",
      "tip": "Mantén vibraciones simples y limpias en \"ryouri\" y \"karakunai\"."
    },
    "sh-16": {
      "meaning": "Trabajé hasta tarde por la noche.",
      "focus": "Vibraciones suaves de \"ru\" y \"ra\" dentro de la frase",
      "tip": "Vibraciones rápidas y suaves en \"ru\" de \"yoru\" y \"ra\" de \"hataraki\"."
    },
    "sh-17": {
      "meaning": "Voy a Japón en avión.",
      "focus": "Fricativa palatal sorda de \"hi\" y la partícula de medio \"de\"",
      "tip": "Dirige el aire hacia el paladar duro en \"hi\" sin que se convierta en \"shi\"."
    },
    "sh-18": {
      "meaning": "Hay un gatito debajo del escritorio.",
      "focus": "Contraste entre \"chi\" y \"tsu\" y el verbo de existencia para seres vivos \"imasu\"",
      "tip": "Practica alternar con claridad entre \"chi\" en \"chiisai\" y \"tsu\" en \"tsukue\"."
    }
  }
}
